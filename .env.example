# Final HTTPS origin, without a path. Leave blank until the domain is confirmed.
# Blank uses the Vercel preview URL, noindex, robots Disallow / and an empty sitemap.
NEXT_PUBLIC_SITE_URL=
# Only enable after the real privacy notice, recipient and server-side protections are configured.
# Endpoint must accept JSON and return {"success":true} only after confirmed receipt.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Vercel Marketplace > Turso Cloud integration provides these values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# PBKDF2 value in the form 100000:<32 hex salt>:<64 hex digest>. Keep server-side only.
ADMIN_PASSWORD_HASH=
